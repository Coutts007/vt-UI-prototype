{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs apps/web/dist 4180",
      "startServerReadyPattern": "serving",
      "url": ["http://127.0.0.1:4180/", "http://127.0.0.1:4180/login"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "interactive": [
          "error",
          {
            "maxNumericValue": 3500
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 31457280
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
