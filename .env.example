# Copy to .env for local overrides. Never commit real values.
ENV=development
LOG_LEVEL=INFO
POSTGRES_USER=vt
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=vt
VT_APP_DB_PASSWORD=change-me-locally-too
# The nightly retention job's database role. Production refuses the development value.
VT_RETENTION_DB_PASSWORD=change-me-locally-three
# Production refuses to start with the development secrets.
JWT_SECRET=change-me-at-least-32-characters-long
IP_PEPPER=change-me-too
# Signs the 10-minute sheet links. At least 32 characters in production.
SIGNED_URL_SECRET=change-me-as-well-at-least-32-characters
# Host ports for `make up`. Change them if 80 or 443 are already in use.
VT_HTTP_PORT=80
VT_HTTPS_PORT=443
# Web build
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
# The tailor directory (D27). Leave unset: off in production builds, on in dev and mock builds.
# Production stays off until the client flow runs on the real API (M8).
# VITE_FEATURE_DIRECTORY=true
# Front-camera self-capture (A4) and the torch cue experiment (A3 item 5). Same rule: off in production
# builds, on in dev and mock builds. The rear camera stays the default until the pilot shows otherwise.
# VITE_FEATURE_FRONT_CAMERA=true
# VITE_FEATURE_TORCH_CUE=true
# The API's own switch for the directory (D27). Off answers 404 on the public directory endpoints and on
# the listing opt-in. M8 and M11's cleanup job now exist; turning it on in production is the owner's call.
DIRECTORY_ENABLED=false
# Codes issued per day from the directory, for one tailor and across all tailors.
DIRECTORY_CODES_PER_TAILOR_DAY=50
DIRECTORY_CODES_GLOBAL_DAY=1000
# Production only (deploy/prod.env, written by `make prod-secrets`): the public host name, the
# certificate contact email, the data directory on the encrypted disk, and the owner's age public
# key that every nightly backup is encrypted to. The private key stays offline with the owner.
# VT_SITE_ADDRESS=vt.example.org
# VT_ACME_EMAIL=you@example.org
# VT_DATA_DIR=/srv/vt
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_KEEP_DAYS=30
# VT_API_WORKERS=2
