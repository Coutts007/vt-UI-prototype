# Copy to .env for local overrides. Never commit real values.
ENV=development
LOG_LEVEL=INFO
POSTGRES_USER=vt
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=vt
DATABASE_URL=postgresql+asyncpg://vt:change-me-locally@db:5432/vt
# Host ports for `make up`. Change them if 80 or 443 are already in use.
VT_HTTP_PORT=80
VT_HTTPS_PORT=443
# Web build
VITE_API_MODE=mock
VITE_API_BASE_URL=/api/v1
